#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

// Layer Index Definitions
#define BASE 0
#define QWERTY 1
#define GAME 2
#define GAME_NUM 3
#define FUNC 4
#define NUM 5
#define NAV 6
#define MOUSE 7
#define FUTURE1 8
#define FUTURE2 9

/* Overriding Mouse Driver Defaults */
&mmv {
    time-to-max-speed-ms = <300>;    /* Fast ramp-up */
    acceleration-exponent = <1>;     /* Smooth linear curve */
};

&msc {
    time-to-max-speed-ms = <100>;    /* Snappy scroll speed */
    acceleration-exponent = <1>;
};

/ {
    behaviors {
        /* Home Row Mods (Matching Kanata $t-hrm = 300ms) */
        hm: home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        /* Precision / Slow Mouse Mode (~1500 speed limit) */
        mmv_slow: mouse_move_slow {
            compatible = "zmk,behavior-point-device-move";
            #binding-cells = <1>;
            x-input-code = <0>;
            y-input-code = <1>;
            time-to-max-speed-ms = <500>;
            acceleration-exponent = <0>; /* Constant precision speed */
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* Layer 0: Base Layer (Colemak-DH + Home Row Mods) */
        base_layer {
            bindings = <
                /* LEFT HALF */                                                                              /* RIGHT HALF */
                &kp Q         &kp W         &kp F         &kp P         &kp B            &kp J         &kp L         &kp U         &kp Y         &kp MINUS
                &hm LMETA A   &hm LALT S    &hm LCTRL R   &hm LSHFT T   &hm TAB G        &hm TAB M     &hm RSHFT N   &hm RCTRL E   &hm RALT I    &hm RMETA O
                &kp Z         &kp X         &kp C         &kp D         &kp V            &kp K         &kp H         &kp COMMA     &kp DOT       &kp FSLH
                &none         &none         &none         &lt NUM ENTER &mo FUNC         &lt NAV SPACE &lt MOUSE BSPC &none        &none         &none
            >;
        };

        /* Layer 1: QWERTY Layer (No Home Row Mods for Guests) */
        qwerty_layer {
            bindings = <
                /* LEFT HALF */                                                                              /* RIGHT HALF */
                &kp Q         &kp W         &kp E         &kp R         &kp T            &kp Y         &kp U         &kp I         &kp O         &kp P
                &kp A         &kp S         &kp D         &kp F         &kp G            &kp H         &kp J         &kp K         &kp L         &kp SEMI
                &kp Z         &kp X         &kp C         &kp V         &kp B            &kp N         &kp M         &kp COMMA     &kp DOT       &kp FSLH
                &none         &none         &none         &lt NUM ENTER &mo FUNC         &lt NAV SPACE &lt MOUSE BSPC &none        &none         &none
            >;
        };

        /* Layer 2: Game Layer (WASD Optimized) */
        game_layer {
            bindings = <
                /* LEFT HALF */                                                                              /* RIGHT HALF */
                &mt ESC TAB   &kp Q         &kp W         &kp E         &kp R            &to BASE      &msc SCRL_UP  &mmv MOVE_UP  &msc SCRL_DN  &none
                &kp LSHFT     &kp A         &kp S         &kp D         &kp F            &none         &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &none
                &kp LCTRL     &kp Z         &kp X         &kp C         &kp V            &none         &none         &none         &none         &none
                &none         &none         &none         &mo GAME_NUM  &kp SPACE        &mkp LCLK     &mkp RCLK     &none         &none         &none
            >;
        };

        /* Layer 3: Game Number Layer */
        game_num_layer {
            bindings = <
                /* LEFT HALF */                                                                              /* RIGHT HALF */
                &none         &kp N1        &kp N2        &kp N3        &kp N4           &none         &none         &none         &none         &none
                &none         &kp N5        &kp N6        &kp N7        &kp N8           &none         &none         &none         &none         &none
                &none         &kp N9        &kp N0        &none         &none            &none         &none         &none         &none         &none
                &none         &none         &none         &trans        &trans           &none         &none         &none         &none         &none
            >;
        };

        /* Layer 4: Function & System Layer */
        func_layer {
            bindings = <
                /* LEFT HALF */                                                                              /* RIGHT HALF */
                &to QWERTY    &to BASE      &to GAME      &to FUTURE1   &to FUTURE2      &kp C_MUTE    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PREV    &kp C_NEXT
                &none         &none         &none         &none         &none            &kp C_BRI_UP  &kp C_BRI_DN  &kp PSCRN     &kp LC(Z)     &kp LC(Y)
                &none         &none         &none         &none         &none            &bt BT_CLR_ALL &bt BT_SEL 0 &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR
                &none         &none         &none         &trans        &trans           &trans        &trans        &none         &none         &none
            >;
        };

        /* Layer 5: Number & Symbol Layer (Kanata Symbol-Pad Mapping) */
        num_layer {
            bindings = <
                /* LEFT HALF */                                                                              /* RIGHT HALF */
                &trans        &kp AT        &kp GRAVE     &kp CARET     &kp TILDE        &kp BSLH      &kp PIPE      &kp COLON     &kp LBKT      &kp RBKT
                &hm LMETA N1  &hm LALT N2   &hm LCTRL N3  &hm LSHFT N4  &kp N5           &kp N6        &hm RSHFT N7  &hm RCTRL N8  &hm RALT N9   &hm RMETA N0
                &kp FSLH      &kp ASTRK     &kp PLUS      &kp MINUS     &kp EQUAL        &kp DOT       &kp UNDER     &kp LBRC      &kp RBRC      &kp SEMI
                &none         &none         &none         &trans        &trans           &trans        &trans        &none         &none         &none
            >;
        };

        /* Layer 6: Navigation Layer */
        nav_layer {
            bindings = <
                /* LEFT HALF */                                                                              /* RIGHT HALF */
                &trans        &trans        &trans        &trans        &trans           &trans        &kp HOME      &kp UP        &kp END       &trans
                &kp LMETA     &kp LALT      &kp LCTRL     &kp LSHFT     &kp TAB          &trans        &kp LEFT      &kp DOWN      &kp RIGHT     &trans
                &trans        &trans        &trans        &trans        &trans           &trans        &kp PG_DN     &kp PG_UP     &trans        &trans
                &none         &none         &none         &trans        &trans           &trans        &trans        &none         &none         &none
            >;
        };

        /* Layer 7: Mouse Layer (Fast & Precision Modes) */
        mouse_layer {
            bindings = <
                /* LEFT HALF */                                                                              /* RIGHT HALF */
                &to BASE      &none         &none         &none         &none            &to BASE      &mkp LCLK     &mmv MOVE_UP  &mkp RCLK     &msc SCRL_UP
                &none         &none         &none         &none         &none            &tog MOUSE    &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &msc SCRL_DN
                &none         &none         &none         &none         &none            &none         &mmv_slow MOVE_LEFT &mmv_slow MOVE_RIGHT &msc SCRL_LEFT &msc SCRL_RIGHT
                &none         &none         &none         &mkp LCLK     &mkp RCLK        &trans        &trans        &none         &none         &none
            >;
        };

        /* Layer 8: Future Layer 1 */
        future1_layer {
            bindings = <
                /* LEFT HALF */                                                                              /* RIGHT HALF */
                &none         &none         &none         &none         &none            &to BASE      &none         &none         &none         &none
                &none         &none         &none         &none         &none            &none         &none         &none         &none         &none
                &none         &none         &none         &none         &none            &none         &none         &none         &none         &none
                &none         &none         &none         &trans        &trans           &trans        &trans        &none         &none         &none
            >;
        };

        /* Layer 9: Future Layer 2 */
        future2_layer {
            bindings = <
                /* LEFT HALF */                                                                              /* RIGHT HALF */
                &none         &none         &none         &none         &none            &to BASE      &none         &none         &none         &none
                &none         &none         &none         &none         &none            &none         &none         &none         &none         &none
                &none         &none         &none         &none         &none            &none         &none         &none         &none         &none
                &none         &none         &none         &trans        &trans           &trans        &trans        &none         &none         &none
            >;
        };
    };
};
