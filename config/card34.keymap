/* Custom Pointer & Scroll Speed Defines (Must be placed before includes) */
#define ZMK_POINTING_DEFAULT_MOVE_VAL 10000
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/bt.h>


// Clean Layer Index Definitions
#define COLEMAK  0
#define QWERTY   1
#define GAME     2
#define GAME_NUM 3   /* Left-hand weapon/number overlay for gaming */
#define FUNC     4
#define NAV      5
#define NUM      6
#define ART      7   
#define ART_NAV  8   
#define TENKEY   9   /* Right-hand 10-key Numpad activated via NUM + dt_ent */
#define STENO    10  /* for steno typing test*/

/* Mouse & Scroll Acceleration Adjustments */
&msc {
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <1>;
};

&mmv {
    time-to-max-speed-ms = <300>;
    acceleration-exponent = <2>;
};

/ {
    behaviors {
        /* Macro: Windows Sleep Sequence (Win+X -> U -> S) */
        macro_sleep: macro_sleep {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <500>;
            tap-ms = <30>;
            bindings = <&kp LG(X) &kp U &kp S>;
        };

        macro_eraser: macro_eraser {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <100>;
            tap-ms = <30>;
            bindings = <&kp LA(D) &kp G &kp SPACE>;
        };

        macro_pen1: macro_pen1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <100>;
            tap-ms = <30>;
            bindings = <&kp LA(D) &kp G &kp RIGHT &kp RIGHT &kp SPACE>;
        };

        macro_pen2: macro_pen2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <100>;
            tap-ms = <30>;
            bindings = <&kp LA(D) &kp G &kp RIGHT &kp RIGHT &kp RIGHT &kp SPACE>;
        };

        macro_lasso: macro_lasso {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <100>;
            tap-ms = <30>;
            bindings = <&kp LA(D) &kp L>;
        };
        prank: windows_update_prank{
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings 
                = <&kp LG(R)>
                , <&macro_wait_time 1000>
                , <&kp C &kp M &kp D &kp SPACE &kp FSLH &kp C &kp SPACE &kp DQT &kp S &kp T &kp A &kp R &kp T &kp SPACE &kp M &kp S &kp E &kp D &kp G &kp E &kp MINUS &kp MINUS &kp K &kp I &kp O &kp S &kp K &kp SPACE &kp H &kp T &kp T &kp P &kp S &kp COLON>
                , <&kp FSLH &kp FSLH &kp F &kp A &kp K &kp E &kp U &kp P &kp D &kp A &kp T &kp E &kp DOT &kp N &kp E &kp T &kp FSLH &kp W &kp I &kp N &kp N1 &kp N0 &kp U &kp E &kp FSLH &kp SPACE &kp MINUS &kp MINUS &kp E &kp D &kp G &kp E &kp MINUS>
                , <&kp K &kp I &kp O &kp S &kp K &kp MINUS &kp T &kp Y &kp P &kp E &kp EQUAL &kp F &kp U &kp L &kp L &kp S &kp C &kp R &kp E &kp E &kp N &kp DQT>
                , <&kp ENTER>;
        };


        /* Fast Home Row Mod (Index Fingers: T, N / N5, N6) */
        hm: home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <100>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        /* Slow Home Row Mod (Pinky/Ring/Middle: A, S, R, I, O, E) */
        hms: home_row_mod_slow {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        /* Tap-Dance: Single = Q, Double = TAB, Triple = ESC */
        q_tab_esc: q_tab_esc_tapdance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <220>;
            bindings = <&kp Q>, <&kp TAB>, <&kp ESC>;
        };

        /* Tap-Dance: Single = Shift, Double = Enter */
        dt_ent: double_tap_enter {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&kp ENTER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* Layer 0: Colemak-DH Base Layer */
        colemak_layer {
            bindings = <
                &q_tab_esc     &kp W          &kp F          &kp P          &kp G             &kp J          &kp L          &kp U          &kp Y          &kp MINUS
                &hms LMETA A   &hms LALT S    &hms LCTRL R   &hm LSHFT T    &kp D             &kp H          &hm RSHFT N    &hms RCTRL E   &hms RALT O    &hms RMETA I
                &kp Z          &kp X          &kp C          &kp V          &kp B             &kp K          &kp M          &kp COMMA      &kp DOT        &kp FSLH
                &none          &none          &none          &dt_ent        &mo NUM           &lt NAV SPACE  &lt FUNC BSPC  &none          &none          &none
            >;
        };

        /* Layer 1: QWERTY Layer */
        qwerty_layer {
            bindings = <
                &kp Q          &kp W          &kp E          &kp R          &kp T             &kp Y          &kp U          &kp I          &kp O          &kp P
                &kp A          &kp S          &kp D          &kp F          &kp G             &kp H          &kp J          &kp K          &kp L          &kp SEMI
                &kp Z          &kp X          &kp C          &kp V          &kp B             &kp N          &kp M          &kp COMMA      &kp DOT        &kp FSLH
                &none          &none          &none          &dt_ent        &mo NUM           &lt NAV SPACE  &lt FUNC BSPC  &none          &none          &none
            >;
        };

        /* Layer 2: Base Game Layer */
        game_layer {
            bindings = <
                &kp ESC        &kp Q          &kp W          &kp E          &kp R             &none          &none          &none          &none          &none
                &kp LSHIFT     &kp A          &kp S          &kp D          &kp F             &none          &none          &none          &none          &none
                &kp LCTRL      &kp Z          &kp X          &kp C          &kp V             &none          &none          &none          &none          &none
                &none          &none          &none          &sl GAME_NUM   &kp SPACE         &none          &none          &none          &none          &none
            >;
        };

        /* Layer 3: Game Quick-Select Overlay */
        game_num_layer {
            bindings = <
                &kp GRAVE      &kp N4         &kp N5         &kp N6         &kp T             &none          &none          &none          &none          &none
                &kp TAB        &kp N1         &kp N2         &kp N3         &kp G             &none          &none          &none          &none          &none
                &trans         &trans         &trans         &trans         &kp B             &none          &none          &none          &none          &none
                &none          &none          &none          &trans         &to COLEMAK       &none          &none          &none          &none          &none
            >;
        };

        /* Layer 4: Function & System Layer */
        func_layer {
            bindings = <
                &soft_off      &kp C_BRI_UP   &kp C_VOL_UP   &kp C_MUTE     &kp C_FF          &prank         &kp LC(LS(TAB)) &kp LG(UP)    &kp LC(TAB)    &kp PSCRN
                &none          &kp C_BRI_DN   &kp C_VOL_DN   &kp C_PP       &kp C_RW          &kp LA(F4)     &kp LG(LC(LEFT)) &kp LG(DOWN) &kp LG(LC(RIGHT)) &macro_sleep
                &to COLEMAK    &to QWERTY     &to GAME       &to ART        &to STENO         &to NAV        &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_CLR
                &none          &none          &none          &trans         &trans            &trans         &trans         &none          &none          &none
            >;
        };

        /* Layer 5: Navigation & Mouse Layer */
        nav_layer {
            bindings = <
                &kp ESC        &kp HOME       &kp UP         &kp END        &kp SPACE         &kp LC(C)      &mkp LCLK      &mmv MOVE_UP   &mkp RCLK      &msc SCRL_UP
                &kp LCTRL      &kp LEFT       &kp DOWN       &kp RIGHT      &kp BSPC          &kp LC(V)      &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &msc SCRL_DOWN
                &kp LMETA      &kp LALT       &kp LCTRL      &kp LSHFT      &kp TAB           &to COLEMAK    &kp LCTRL      &mkp MCLK      &msc SCRL_LEFT &msc SCRL_RIGHT
                &none          &none          &none          &kp LCTRL      &kp LSHFT         &mkp LCLK      &mkp RCLK      &none          &none          &none
            >;
        };

        /* Layer 6: Number Layer */
        num_layer {
            bindings = <
                &kp EXCL       &kp DQT        &kp HASH       &kp DLLR       &kp PRCNT         &kp AMPS       &kp SQT        &kp LPAR       &kp RPAR       &kp PLUS
                &hms LMETA N1  &hms LALT N2   &hms LCTRL N3  &hm LSHFT N4   &kp N5            &kp N6         &hm RSHFT N7   &hms RCTRL N8  &hms RALT N9   &hms RMETA N0
                &kp GRAVE      &kp AT         &kp PIPE       &kp COLON      &kp BSLH          &kp EQUAL      &kp UNDER      &kp LBKT       &kp RBKT       &kp SEMI
                &none          &none          &none          &mo TENKEY     &trans            &trans         &trans         &none          &none          &none
            >;
        };

        /* Layer 7: Reserved Art / Macropad Layer */
        art_layer {
            bindings = <
                &macro_lasso   &macro_eraser  &macro_pen1    &macro_pen2    &none             &none          &none          &none          &none          &none
                &kp Q          &kp E          &kp B          &kp G          &kp I             &none          &none          &none          &none          &none
                &none          &none          &none          &none          &none             &none          &none          &none          &none          &none
                &none          &none          &none          &kp LC(Z)      &mo ART_NAV       &none          &to COLEMAK    &none          &none          &none
            >;
        };

        /* Layer 8: Blank Expansion Layer */
        art_nav_layer {
            bindings = <
                &none          &none          &msc SCRL_UP   &none          &none             &none          &none          &none          &none          &none
                &none          &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_RIGHT &none            &none          &none          &none          &none          &none
                &none          &none          &none          &none          &none             &none          &none          &none          &none          &none
                &none          &none          &none          &to COLEMAK    &trans            &trans         &trans         &none          &none          &none
            >;
        };

        /* Layer 9: Right-Hand 10-Key Numpad (Activated via NUM + dt_ent) */
        tenkey_layer {
            bindings = <
                &kp ESC        &kp LPAR       &kp RPAR       &kp PRCNT      &kp TAB           &kp FSLH       &kp N7         &kp N8         &kp N9         &kp MINUS
                &kp LSHFT      &kp LALT       &kp LCTRL      &kp LMETA      &kp BSPC          &kp ASTRK      &kp N4         &kp N5         &kp N6         &kp PLUS
                &none          &kp COMMA      &kp COLON      &kp SEMI       &kp ENTER         &kp EQUAL      &kp N1         &kp N2         &kp N3         &kp BSPC
                &none          &none          &none          &trans         &trans            &kp N0         &kp DOT        &none          &none          &none
            >;
        };

        /* Layer 10: Stenograph Layer */
        stenograph_layer {
            bindings = <
                &kp N1         &kp W          &kp E          &kp R          &kp T             &kp U          &kp I          &kp O          &kp P          &kp LBKT
                &kp A          &kp S          &kp D          &kp F          &kp G             &kp J          &kp K          &kp L          &kp SEMI       &kp SQT
                &to COLEMAK    &none          &none          &none          &none             &lt NAV SPACE  &none          &none          &none          &kp BKSP
                &none          &none          &none          &kp C          &kp V             &kp N          &kp M          &none          &none          &none
            >;
        };
    };
};
