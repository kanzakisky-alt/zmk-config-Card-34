/* Custom Pointer & Scroll Speed Defines (Must be placed before includes) */
#define ZMK_POINTING_DEFAULT_MOVE_VAL 10000
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/bt.h>

// Clean Layer Index Definitions
#define COLEMAK  0
#define QWERTY   1
#define GAME     2
#define GAME_NUM 3   /* Left-hand weapon/number overlay for gaming */
#define FUNC     4
#define NAV      5
#define NUM      6
#define ART      7   /* Reserved: Left-hand Macropad for Drawing / Krita */
#define BLANK_1  8   /* Reserved for future expansion */

/* Mouse & Scroll Acceleration Adjustments */
&msc {
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <1>;
};

&mmv {
    time-to-max-speed-ms = <300>;
    acceleration-exponent = <2>;
};

/ {
    behaviors {
        /* Macro: Windows Sleep Sequence (Win+X -> U -> S) */
        macro_sleep: macro_sleep {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <500>;
            tap-ms = <30>;
            bindings
                = <&kp LG(X)>
                , <&kp U>
                , <&kp S>
                ;
        };

        /* Home Row Mods (Hold = Modifier, Tap = Key) */
        hm: home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp &kp>;
        };

        /* Tap-Dance: Single = Q, Double = TAB, Triple = ESC */
        q_tab_esc: q_tab_esc_tapdance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <220>;
            bindings = <&kp Q>, <&kp TAB>, <&kp ESC>;
        };

        /* Hold-Tap Helper: Accepts hold and tap key arguments */
        sh_ent: shift_enter_holdtap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "hold-preferred";
            bindings = <&kp &kp>;
        };

        /* Tap-Dance: Single/Hold = Enter/Shift, Double Tap = Caps Word */
        ent_sh_caps: enter_shift_caps_tapdance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <220>;
            bindings = <&sh_ent LSHFT ENTER>, <&caps_word>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* Layer 0: Colemak-DH Base Layer */
        colemak_layer {
            bindings = <
                &q_tab_esc    &kp W         &kp F         &kp P         &kp G            &kp J         &kp L         &kp U         &kp Y         &kp MINUS
                &hm LMETA A   &hm LALT S    &hm LCTRL R   &hm LSHFT T   &kp D            &kp H         &hm RSHFT N   &hm RCTRL E   &hm RALT O    &hm RMETA I
                &kp Z         &kp X         &kp C         &kp V         &kp B            &kp K         &kp M         &kp COMMA     &kp DOT       &kp FSLH
                &none         &none         &none         &ent_sh_caps  &mo NUM          &lt NAV SPACE &lt FUNC BSPC &none         &none         &none
            >;
        };

        /* Layer 1: QWERTY Layer */
        qwerty_layer {
            bindings = <
                &kp Q         &kp W         &kp E         &kp R         &kp T            &kp Y         &kp U         &kp I         &kp O         &kp P
                &kp A         &kp S         &kp D         &kp F         &kp G            &kp H         &kp J         &kp K         &kp L         &kp SEMI
                &kp Z         &kp X         &kp C         &kp V         &kp B            &kp N         &kp M         &kp COMMA     &kp DOT       &kp FSLH
                &none         &none         &none         &ent_sh_caps  &mo NUM          &lt NAV SPACE &lt FUNC BSPC &none         &none         &none
            >;
        };

        /* Layer 2: Base Game Layer */
        game_layer {
            bindings = <
                &kp ESC       &kp Q         &kp W         &kp E         &kp R            &none         &none         &none         &none         &none
                &kp LSHIFT    &kp A         &kp S         &kp D         &kp F            &none         &none         &none         &none         &none
                &kp LCTRL     &kp Z         &kp X         &kp C         &kp V            &none         &none         &none         &none         &none
                &none         &none         &none         &sl GAME_NUM  &kp SPACE        &none         &none         &none         &none         &none
            >;
        };

        /* Layer 3: Game Quick-Select Overlay (1, 2, 3, 4 + Utility) */
        game_num_layer {
            bindings = <
                &kp GRAVE     &kp N4        &kp N5        &kp N6        &kp T            &none         &none         &none         &none         &none
                &kp TAB       &kp N1        &kp N2        &kp N3        &kp G            &none         &none         &none         &none         &none
                &trans        &trans        &trans        &trans        &kp B            &none         &none         &none         &none         &none
                &none         &none         &none         &trans        &trans           &none         &none         &none         &none         &none
            >;
        };

        /* Layer 4: Function & System Layer */
        func_layer {
            bindings = <
                &soft_off     &kp C_BRI_UP  &kp C_VOL_UP  &kp C_MUTE    &kp C_FF         &none         &kp LC(LS(TAB)) &kp LG(UP)   &kp LC(TAB)   &kp PSCRN
                &macro_sleep  &kp C_BRI_DN  &kp C_VOL_DN  &kp C_PP      &kp C_RW         &none         &kp LG(LC(LEFT)) &kp LG(DOWN) &kp LG(LC(RIGHT)) &none
                &to COLEMAK   &to QWERTY    &to GAME      &to ART       &none            &to NAV       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR
                &none         &none         &none         &trans        &trans           &trans        &trans        &none         &none         &none
            >;
        };

        /* Layer 5: Navigation & Mouse Layer */
        nav_layer {
            bindings = <
                &kp ESC       &kp HOME      &kp UP        &kp END       &kp SPACE        &kp LC(C)     &mkp LCLK     &mmv MOVE_UP  &mkp RCLK     &msc SCRL_UP
                &kp LCTRL     &kp LEFT      &kp DOWN      &kp RIGHT     &kp BSPC         &kp LC(V)     &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &msc SCRL_DOWN
                &kp LMETA     &kp LALT      &kp LCTRL     &kp LSHFT     &kp TAB          &to COLEMAK   &trans        &trans        &msc SCRL_LEFT &msc SCRL_RIGHT
                &none         &none         &none         &kp LCTRL     &kp LSHFT        &mkp LCLK     &mkp RCLK     &none         &none         &none
            >;
        };

        /* Layer 6: Number Layer */
        num_layer {
            bindings = <
                &kp EXCL      &kp DQT       &kp HASH      &kp DLLR      &kp PRCNT        &kp AMPS      &kp SQT       &kp LPAR      &kp RPAR      &kp PLUS
                &hm LMETA N1  &hm LALT N2   &hm LCTRL N3  &hm LSHFT N4  &kp N5           &kp N6        &hm RSHFT N7  &hm RCTRL N8  &hm RALT N9   &hm RMETA N0
                &kp GRAVE     &kp AT        &kp PIPE      &kp COLON     &kp BSLH         &kp EQUAL     &kp UNDER     &kp LBKT      &kp RBKT      &kp SEMI
                &none         &none         &none         &trans        &trans           &trans        &trans        &none         &none         &none
            >;
        };

        /* Layer 7: Reserved Art / Macropad Layer (Left hand Drawing shortcuts) */
        art_layer {
            bindings = <
                &none         &none         &none         &none         &none            &none         &none         &none         &none         &none
                &none         &none         &none         &none         &none            &none         &none         &none         &none         &none
                &none         &none         &none         &none         &none            &none         &none         &none         &none         &none
                &none         &none         &none         &trans        &trans           &trans        &trans        &none         &none         &none
            >;
        };

        /* Layer 8: Blank Expansion Layer */
        blank_layer {
            bindings = <
                &none         &none         &none         &none         &none            &none         &none         &none         &none         &none
                &none         &none         &none         &none         &none            &none         &none         &none         &none         &none
                &none         &none         &none         &none         &none            &none         &none         &none         &none         &none
                &none         &none         &none         &trans        &trans           &trans        &trans        &none         &none         &none
            >;
        };
    };
};
