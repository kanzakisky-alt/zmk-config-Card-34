/* Custom Pointer & Scroll Speed Defines (Must be placed before includes) */
#define ZMK_POINTING_DEFAULT_MOVE_VAL 10000
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/bt.h>

// Layer Index Definitions
#define COLEMAK 0
#define QWERTY  1
#define GAME    2
#define FUNC    3
#define NAV     4
#define NUM     5

/* Mouse & Scroll Acceleration Adjustments */
&msc {
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <1>;
};

&mmv {
    time-to-max-speed-ms = <300>;   /* Rapidly ramps up max speed on hold */
    acceleration-exponent = <2>;     /* Linear curve for smooth travel */
};

/ {
    behaviors {
        /* Macro: Windows Sleep Sequence (Win+X -> U -> S) */
        macro_sleep: macro_sleep {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <300>;
            tap-ms = <30>;
            bindings
                = <&kp LG(X)>
                , <&kp U>
                , <&kp S>
                ;
        };

        /* Home Row Mods (Hold = Modifier, Tap = Key) */
        hm: home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        /* Tap-Dance 1: Single = Q, Double = TAB, Triple = ESC */
        q_tab_esc: q_tab_esc_tapdance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <220>;
            bindings = <&kp Q>, <&kp TAB>, <&kp ESC>;
        };

        /* Tap-Dance 2: Single/Hold = Shift, Double = Enter */
        sh_ent: shift_enter_tapdance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&kp ENTER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* Layer 0: Colemak-DH Base Layer */
        colemak_layer {
            bindings = <
                /* LEFT HALF */                                                 /* RIGHT HALF */
                &q_tab_esc    &kp W         &kp F         &kp P         &kp G            &kp J         &kp L         &kp U         &kp Y         &kp MINUS
                &hm LMETA A   &hm LALT S    &hm LCTRL R   &hm LSHFT T   &kp D            &kp H         &hm RSHFT N   &hm RCTRL E   &hm RALT O    &hm RMETA I
                &kp Z         &kp X         &kp C         &kp V         &kp B            &kp K         &kp M         &kp COMMA     &kp DOT       &kp FSLH
                &none         &none         &none         &mo NUM       &sh_ent          &lt NAV SPACE &lt FUNC BSPC &none         &none         &none
            >;
        };

        /* Layer 1: QWERTY Layer */
        qwerty_layer {
            bindings = <
                &kp Q         &kp W         &kp E         &kp R         &kp T            &kp Y         &kp U         &kp I         &kp O         &kp P
                &kp A         &kp S         &kp D         &kp F         &kp G            &kp H         &kp J         &kp K         &kp L         &kp SEMI
                &kp Z         &kp X         &kp C         &kp V         &kp B            &kp N         &kp M         &kp COMMA     &kp DOT       &kp FSLH
                &none         &none         &none         &mo NUM       &sh_ent          &lt NAV SPACE &lt FUNC BSPC &none         &none         &none
            >;
        };
        /* Layer 2: Game Layer */
        game layer {
            bindings = <
                &kp ESC       &kp Q         &kp W         &kp E         &kp T            &trans        &trans        &mmv MOVE_UP   &trans        &mcs SCRL_UP        
                &kp LCTRL     &kp A         &kp S         &kp D         &kp F            &trans        &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &mcs SCRL_DOWN        
                &kp LSHIFT    &kp Z         &kp X         &kp C         &kp V            &trans        &kp N1        &kp N2        &N3        &N4        
                &none         &none         &none         &mo FUNC      &kp SPACE        &mkp LCLK     &mkp RCLK     &none          &none          &none
            >;
        };
        /* Layer 4: Function & System Layer */
        func_layer {
            bindings = <
                /* LEFT HALF */                                                 /* RIGHT HALF */
                &none         &none         &none         &none         &none            &none         &none         &none         &none         &none
                &none         &none         &none         &none         &none            &none         &none         &none         &none         &none
                &to QWERTY    &to GAME      &to COLEMAK   &none         &none            &tog NAV      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR
                &none         &none         &none         &trans        &trans           &trans        &trans        &none         &none         &none
            >;
        };
        /* Layer 3: Custom Navigation & Mouse Layer */
        nav_layer {
            bindings = <
                /* LEFT HALF */                                                 /* RIGHT HALF */
                &kp ESC       &kp HOME      &kp UP        &kp END       &kp SPACE        &kp LC(C)     &mkp LCLK     &mmv MOVE_UP   &mkp RCLK      &msc SCRL_UP
                &kp LCTRL     &kp LEFT      &kp DOWN      &kp RIGHT     &kp BSPC         &kp LC(V)     &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &msc SCRL_DOWN
                &kp LMETA     &kp LALT      &kp LCTRL     &kp LSHFT     &kp TAB          &trans        &kp LC(msc SCRL_UP) &kp LC(msc SCRL_DOWN) &msc SCRL_LEFT  &msc SCRL_RIGHT
                &none         &none         &none         &kp LCTRL     &kp LSHFT        &mkp LCLK     &mkp RCLK     &none          &none          &none
            >;
        };
        /* Layer 5: Number Layer */
        num_layer {
            bindings = <
                /* LEFT HALF */                                                 /* RIGHT HALF */
                &kp AT        &kp GRAVE     &kp CARET     &kp TILDE     &kp BSLH         &kp PIPE      &kp COLON     &kp LBKT      &kp RBKT      &kp PLUS
                &hm LMETA N1  &hm LALT N2   &hm LCTRL N3  &hm LSHFT N4  &kp N5           &kp N6        &hm RSHFT N7  &hm RCTRL N8  &hm RALT N9   &hm RMETA N0
                &kp FSLH      &kp ASTRK     &kp PLUS      &kp MINUS     &kp EQUAL        &kp DOT       &kp UNDER     &kp LBRC      &kp RBRC      &kp SEMI
                &none         &none         &none         &trans        &trans           &trans        &trans        &none         &none         &none
            >;
        };
    };
};
