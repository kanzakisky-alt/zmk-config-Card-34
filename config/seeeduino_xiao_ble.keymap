#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    /* Built-in Blue LED definition for Seeed XIAO BLE indicator */
    leds {
        compatible = "gpio-leds";
        blue_led: led_2 {
            gpios = <&gpio0 26 GPIO_ACTIVE_LOW>;
            label = "Blue LED";
        };
    };

    aliases {
        led-blue = &blue_led;
    };

    /* Matrix transform mapping 4 rows x 10 columns (5 left + 5 right) */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)    RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)    RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)    RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)    RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";

        row-gpios =
            <&xiao_d 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&xiao_d 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&xiao_d 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&xiao_d 7  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;

        col-gpios =
            <&xiao_d 1 GPIO_ACTIVE_HIGH>,
            <&xiao_d 2 GPIO_ACTIVE_HIGH>,
            <&xiao_d 3 GPIO_ACTIVE_HIGH>,
            <&xiao_d 4 GPIO_ACTIVE_HIGH>,
            <&xiao_d 5 GPIO_ACTIVE_HIGH>;
    };

    keymap {
        compatible = "zmk,keymap";

        /* Layer 0: Test QWERTY Layout */
        default_layer {
            bindings = <
                /* LEFT HALF */                                                         /* RIGHT HALF */
                &kp Q         &kp W           &kp E   &kp R   &kp T        &kp Y        &kp U   &kp I      &kp O     &kp P
                &kp A         &kp S           &kp D   &kp F   &kp G        &kp H        &kp J   &kp K      &kp L     &kp SEMI
                &bt BT_CLR    &bt BT_CLR_ALL  &kp C   &kp V   &kp B        &kp N        &kp M   &kp COMMA  &kp DOT   &kp FSLH
                &kp N1        &kp N2          &kp N3  &kp N4  &kp N5       &kp N6       &kp N7  &kp N8     &kp N9    &kp N0
            >;
        };
    };
};
